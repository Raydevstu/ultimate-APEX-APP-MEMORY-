// ApexPad (APEX-EDITOR-V1) — Unified SQLite Schema
// Combines Claude-Mem sessions/observations, Headroom CCR blocks, Ripwire AST graph,
// Agent-Browser UI snapshots, and ApexPad Project DNA / Artifact Staging.
//
// NOTE: `observations_fts` (FTS5 virtual table) + sync triggers are created at runtime
// via raw SQL in src/server/apexpad/fts.ts (virtual tables are not representable in Prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. CLAUDE-MEM SESSIONS TABLE
model SdkSession {
  sessionId   String  @id @map("session_id")
  projectSlug String  @map("project_slug")
  branchName  String  @default("main") @map("branch_name")
  firstPrompt String  @default("") @map("first_prompt")
  promptCount Int     @default(0) @map("prompt_count")
  status      String  @default("initialized")
  startedAt   String  @map("started_at")
  endedAt     String? @map("ended_at")

  @@index([projectSlug, startedAt], map: "idx_sessions_project")
  @@map("sdk_sessions")
}

// 2. CLAUDE-MEM USER PROMPTS TABLE
model UserPrompt {
  id            Int    @id @default(autoincrement())
  sessionId     String @map("session_id")
  promptNumber  Int    @map("prompt_number")
  rawPrompt     String @map("raw_prompt")
  cleanedPrompt String @map("cleaned_prompt")
  createdAt     String @map("created_at")

  @@index([sessionId], map: "idx_prompts_session")
  @@map("user_prompts")
}

// 3. CLAUDE-MEM + HEADROOM HIERARCHICAL OBSERVATIONS TABLE
model Observation {
  id                String  @id
  sessionId         String  @map("session_id")
  projectSlug       String  @map("project_slug")
  scope             String // global | repo | branch | session
  category          String // decision | bugfix | arch_rule | invariant | tool_trace | security_alert | note_synthesis
  title             String
  subtitle          String
  narrative         String
  factsJson         String  @default("[]") @map("facts_json")
  referencedFiles   String  @default("[]") @map("referenced_files")
  referencedSymbols String  @default("[]") @map("referenced_symbols")
  gitBlobHashes     String  @default("{}") @map("git_blob_hashes")
  confirmationCount Int     @default(1) @map("confirmation_count")
  isStale           Boolean @default(false) @map("is_stale")
  tokenEstimate     Int     @default(0) @map("token_estimate")
  createdAt         String  @map("created_at")
  updatedAt         String  @map("updated_at")

  @@index([projectSlug, scope, isStale, createdAt], map: "idx_obs_project_scope")
  @@index([projectSlug, category], map: "idx_obs_category")
  @@map("observations")
}

// 5. SESSION SUMMARIES TABLE
model SessionSummary {
  sessionId    String @id @map("session_id")
  projectSlug  String @map("project_slug")
  requested    String
  investigated String
  learned      String
  completed    String
  tokenCount   Int    @map("token_count")
  createdAt    String @map("created_at")

  @@map("session_summaries")
}

// 6. HEADROOM CCR (COMPRESS-CACHE-RETRIEVE) LOSSLESS STORE + TOIN SCORING
model CcrBlock {
  ccrId            String @id @map("ccr_id")
  sessionId        String @map("session_id")
  sourceLabel      String @map("source_label")
  contentType      String @map("content_type") // json | code | prose | log | accessibility_tree
  originalBytes    String @map("original_bytes")
  compressedStub   String @map("compressed_stub")
  originalTokens   Int    @map("original_tokens")
  compressedTokens Int    @map("compressed_tokens")
  compressionRatio Float  @map("compression_ratio")
  retrievalCount   Int    @default(0) @map("retrieval_count")
  valueScore       Float  @default(0.5) @map("value_score")
  createdAt        String @map("created_at")

  @@index([sessionId, createdAt], map: "idx_ccr_session")
  @@map("ccr_blocks")
}

// 7. APEXPAD PROJECT DNA (TOKEN ECONOMIZER 3-SESSION PROMOTED INVARIANTS)
model ProjectDna {
  id                   String  @id
  projectSlug          String  @map("project_slug")
  category             String // architecture | convention | forbidden_pattern | environment_fact
  ruleKey              String  @map("rule_key")
  ruleStatement        String  @map("rule_statement")
  sourceObservationIds String  @default("[]") @map("source_observation_ids")
  confirmationSessions Int     @default(1) @map("confirmation_sessions")
  enforcedInCi         Boolean @default(true) @map("enforced_in_ci")
  layerDenyRule        String? @map("layer_deny_rule")
  createdAt            String  @map("created_at")
  updatedAt            String  @map("updated_at")

  @@unique([projectSlug, ruleKey], map: "uq_dna_rule_key")
  @@map("project_dna")
}

// 8. RIPWIRE AST SYMBOL GRAPH NODES (CODE + MARKDOWN HEADINGS)
model AstSymbol {
  symbolId             String  @id @map("symbol_id")
  projectSlug          String  @map("project_slug")
  filePath             String  @map("file_path")
  symbolName           String  @map("symbol_name")
  kind                 String // function | class | interface | method | variable | heading
  signature            String
  startLine            Int     @map("start_line")
  endLine              Int     @map("end_line")
  cyclomaticComplexity Int     @default(1) @map("cyclomatic_complexity")
  gitChurn30d          Int     @default(0) @map("git_churn_30d")
  hasTestCoverage      Boolean @default(false) @map("has_test_coverage")
  pageRankScore        Float   @default(0) @map("pagerank_score")
  fileSha256           String  @map("file_sha256")
  updatedAt            String  @map("updated_at")

  @@index([projectSlug, filePath], map: "idx_ast_file")
  @@index([projectSlug, symbolName], map: "idx_ast_name")
  @@index([projectSlug, pageRankScore], map: "idx_ast_pagerank")
  @@map("ast_symbols")
}

// 9. RIPWIRE DIRECTED CALL & BACKLINK EDGES
model AstEdge {
  edgeId         String @id @map("edge_id")
  projectSlug    String @map("project_slug")
  callerSymbolId String @map("caller_symbol_id")
  calleeSymbolId String @map("callee_symbol_id")
  callerFile     String @map("caller_file")
  calleeFile     String @map("callee_file")
  honestyLabel   String @map("honesty_label") // exact | heuristic_ambiguous | markdown_backlink
  weight         Float  @default(1)

  @@index([projectSlug, callerSymbolId], map: "idx_edges_caller")
  @@index([projectSlug, calleeSymbolId], map: "idx_edges_callee")
  @@map("ast_edges")
}

// 10. AGENT-BROWSER ACCESSIBILITY SNAPSHOTS & REF MAPS
model UiSnapshot {
  snapshotId       String  @id @map("snapshot_id")
  sessionId        String  @map("session_id")
  url              String
  domHash          String  @map("dom_hash")
  compactTextTree  String  @map("compact_text_tree")
  refMapJson       String  @map("ref_map_json")
  diffFromPrevious String? @map("diff_from_previous")
  createdAt        String  @map("created_at")

  @@index([sessionId, createdAt], map: "idx_snap_session")
  @@map("ui_snapshots")
}

// 11. APEXPAD ARTIFACT STAGING & HUMAN APPROVAL GATE
model StagedArtifact {
  artifactId      String @id @map("artifact_id")
  sessionId       String @map("session_id")
  agentRole       String @map("agent_role") // planner | researcher | architect
  targetFilePath  String @map("target_file_path")
  proposedContent String @map("proposed_content")
  unifiedDiff     String @map("unified_diff")
  blastRadiusJson String @map("blast_radius_json")
  status          String @default("staged") // staged | approved | rejected
  createdAt       String @map("created_at")

  @@index([sessionId, createdAt], map: "idx_artifacts_session")
  @@map("staged_artifacts")
}
